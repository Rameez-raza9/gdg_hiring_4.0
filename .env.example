# Deployed Google Apps Script Web App URL (ending in /exec)
VITE_GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Turso Edge SQLite Database (optional - can also be configured via the UI modal)
VITE_TURSO_DATABASE_URL=libsql://your-db-org.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token_here

